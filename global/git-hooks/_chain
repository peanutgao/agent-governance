#!/usr/bin/env bash
# 保留仓库常规 hooks 目录，包含 bare repository 与 linked worktree。
set -uo pipefail

hook_name="$1"
shift
case "$hook_name" in
  ''|*[!a-z-]*) exit 2 ;;
esac

repo_common_dir="$(git rev-parse --git-common-dir)" || exit 1
repo_hook="$repo_common_dir/hooks/$hook_name"
[[ -f "$repo_hook" && -x "$repo_hook" ]] || exit 0

self_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)" || exit 1
[[ "$repo_hook" -ef "$self_dir/$hook_name" ]] && exit 0

# 项目钩子也可能通过命令主动调用全局包装器。仅跳过同一仓库内的重入。
repo_common_dir="$(cd -P "$repo_common_dir" && pwd)" || exit 1
chain_key="$repo_common_dir/hooks/$hook_name"
[[ "${AGENT_GOVERNANCE_ACTIVE_HOOK:-}" == "$chain_key" ]] && exit 0
export AGENT_GOVERNANCE_ACTIVE_HOOK="$chain_key"
exec "$repo_hook" "$@"
