#!/usr/bin/env bash
# 项目可把此入口放在自身 commit-msg 的最后一步。兼容尚未迁移的全局安装。
set -uo pipefail

SELF_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)" || exit 1
if [[ -n "${AGENT_GOVERNANCE_ACTIVE_HOOK:-}" ]]; then
  repo_dir="$(git rev-parse --git-common-dir)" || exit 1
  repo_dir="$(cd -P "$repo_dir" && pwd)" || exit 1
  [[ "$AGENT_GOVERNANCE_ACTIVE_HOOK" != "$repo_dir/hooks/commit-msg" ]] || exit 0
fi
CHECKER="$SELF_DIR/../check-commit-attribution.sh"
[[ -f "$CHECKER" ]] || CHECKER="${HOME:-}/.codex/check-commit-attribution.sh"

MESSAGE_FILE="${1:-}"

if [[ ! -f "$CHECKER" ]]; then
  printf 'commit-msg: 找不到归属检查器（%s）。\n' "$CHECKER" >&2
  printf '           归属检查是硬门禁，检查器缺失时拒绝提交。\n' >&2
  printf '           修复: 重新运行 agent-governance 的 scripts/distribute.sh。\n' >&2
  exit 1
fi

if [[ -z "$MESSAGE_FILE" || ! -f "$MESSAGE_FILE" ]]; then
  printf 'commit-msg: 未收到 commit message 文件路径，拒绝提交。\n' >&2
  exit 1
fi

hooks_path="$(git config --path --get core.hooksPath || true)"
if [[ -n "$hooks_path" && "$hooks_path" -ef "$SELF_DIR" ]]; then
  if [[ ! -f "$SELF_DIR/_chain" ]]; then
    printf 'commit-msg: 缺少旧全局钩子转发器，请重新分发。\n' >&2
    exit 1
  fi
  bash "$SELF_DIR/_chain" commit-msg "$@" || exit "$?"
fi

if ! bash "$CHECKER" --message "$MESSAGE_FILE" >/dev/null; then
  printf '\n提交被 Git 归属约束拦下（见 ~/.codex/AGENTS.md「Git 归属」）。\n' >&2
  printf '改法: 用人类开发者身份提交，并删掉 message 里的 AI 归属声明与「由 AI 生成」类表述。\n' >&2
  printf '拦截清单: bash %s --print-policy\n' "$CHECKER" >&2
  exit 1
fi
